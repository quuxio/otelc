{
  "uid": "otelc-local",
  "title": "otelc instrumentation",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "otelc"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Completed function calls",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "otelc-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(otelc_function_calls_total)",
          "legendFormat": "{{code_function_name}}{{code_object_type}}{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Exceptional function exits",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "otelc-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(otelc_function_unwinds_total)",
          "legendFormat": "{{code_function_name}}{{code_object_type}}{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "Completed object lifetimes",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "otelc-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(otelc_object_lifetimes_total)",
          "legendFormat": "{{code_function_name}}{{code_object_type}}{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Lost observations",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "otelc-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(otelc_runtime_dropped_observations_total)",
          "legendFormat": "{{code_function_name}}{{code_object_type}}{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "Calls by function",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "otelc-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code_function_name) (otelc_function_calls_total)",
          "legendFormat": "{{code_function_name}}{{code_object_type}}{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 6,
      "title": "Function duration p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "otelc-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, code_function_name) (otelc_function_duration_seconds_bucket))",
          "legendFormat": "{{code_function_name}}{{code_object_type}}{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 7,
      "title": "Object lifetime p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "otelc-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, code_object_type) (otelc_object_lifetime_duration_seconds_bucket))",
          "legendFormat": "{{code_function_name}}{{code_object_type}}{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 8,
      "title": "Losses by reason",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "otelc-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (otelc_runtime_dropped_observations_total)",
          "legendFormat": "{{code_function_name}}{{code_object_type}}{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    }
  ]
}
