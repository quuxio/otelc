{
  "name": "otelc-rebuild",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "check:node": "tsc --project adapters/node/tsconfig.json && node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-include='**/adapters/node/src/**/*' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=build/node-lcov.info adapters/node/test/*.test.ts"
  },
  "dependencies": {
    "@babel/core": "8.0.7",
    "@babel/types": "8.0.6",
    "@jridgewell/remapping": "2.3.5",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.300.0",
    "@opentelemetry/instrumentation": "0.300.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "magic-string": "1.4.3",
    "typescript": "7.0.2",
    "typescript-api": "npm:typescript@6.0.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2"
  }
}
